# Copy to .env and adjust. Names and safe placeholders only; never commit real secrets.

# Backend
FACTORYMIND_ENVIRONMENT=development
FACTORYMIND_DATA_DIR=D:/FactoryMind/data
FACTORYMIND_ARTIFACTS_DIR=D:/FactoryMind/artifacts
FACTORYMIND_ANOMALY_MODEL_NAME=metropt3-anomaly

# Frontend dev server proxy target for /api
FACTORYMIND_API_URL=http://127.0.0.1:8000
