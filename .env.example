# Copy to .env and adjust. Names and safe placeholders only; never commit real secrets.

# Backend
FACTORYMIND_ENVIRONMENT=development
FACTORYMIND_DATA_DIR=D:/FactoryMind/data
FACTORYMIND_ARTIFACTS_DIR=D:/FactoryMind/artifacts
FACTORYMIND_ANOMALY_MODEL_NAME=metropt3-anomaly

# Authentication (OIDC resource server). Protected routes answer 401 until all three are set.
FACTORYMIND_AUTH_ISSUER=https://idp.example.com/realms/factory
FACTORYMIND_AUTH_AUDIENCE=factorymind-api
FACTORYMIND_AUTH_JWKS_URL=https://idp.example.com/realms/factory/protocol/openid-connect/certs
# FACTORYMIND_AUTH_JWKS_FILE=D:/FactoryMind/secrets/jwks.json   # air-gapped alternative to the URL
# Single-tenant mode is an explicit opt-in; without it a token with no tenant claim is rejected.
# FACTORYMIND_SINGLE_TENANT_MODE=true
# FACTORYMIND_DEFAULT_TENANT_ID=acme          # required by single-tenant mode
# FACTORYMIND_DATA_SOURCE_TENANT_ID=acme      # tenant that owns the served telemetry/model
#   (defaults to DEFAULT_TENANT_ID in single-tenant mode; with neither set, anomaly and
#   incident data are denied to everyone)
# FACTORYMIND_ASSET_IDS=["metropt3-apu-1"]
# FACTORYMIND_DATA_SOURCE_ASSET_ID=metropt3-apu-1   # the one asset the model/dataset describes
# FACTORYMIND_DATABASE_URL=sqlite:///D:/FactoryMind/data/factorymind.sqlite3

# Frontend dev server proxy target for /api
FACTORYMIND_API_URL=http://127.0.0.1:8000
