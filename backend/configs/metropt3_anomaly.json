{
  "experiment": "metropt3-anomaly",
  "seed": 42,
  "window": {
    "length": "10min",
    "min_coverage": 0.8,
    "max_gap_s": 60.0,
    "resume_gap_s": 600.0
  },
  "splits": {
    "train": ["2020-02-01", "2020-03-17"],
    "calibration": ["2020-03-17", "2020-04-01"],
    "validation": ["2020-04-01", "2020-05-25"],
    "test": ["2020-05-25", "2020-09-02"]
  },
  "startup_exclusion_minutes": 0,
  "early_horizon_hours": 6,
  "post_tolerance_hours": 24,
  "threshold_quantiles": [0.99, 0.995, 0.999],
  "persistence_grid": [1, 3, 6],
  "detectors": {
    "lps_rule": [{}],
    "robust_z": [{}],
    "isolation_forest": [
      {"n_estimators": 300, "max_samples": "auto"},
      {"n_estimators": 300, "max_samples": 2048}
    ],
    "pca_spe": [{"variance": 0.9}, {"variance": 0.95}, {"variance": 0.99}]
  }
}
