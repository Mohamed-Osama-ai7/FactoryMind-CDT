{
  "experiment": "metropt3-anomaly",
  "seed": 42,
  "window": {
    "length": "10min",
    "min_coverage": 0.8,
    "max_gap_s": 60.0,
    "resume_gap_s": 600.0,
    "stopped_off_fraction": 0.9
  },
  "periods": {
    "train": ["2020-02-01", "2020-03-17"],
    "calibration": ["2020-03-17", "2020-04-01"],
    "evaluation": ["2020-04-01", "2020-09-02"]
  },
  "reference": {"exclude_stopped": true, "max_load_duty": 0.9},
  "early_horizon_hours": 6,
  "post_tolerance_hours": 24,
  "persistence_grid": [3, 6],
  "exceedance_alpha": 0.01,
  "detectors": {
    "lps_rule": {"threshold": {"mode": "quantile", "grid": [0.99, 0.995, 0.999]}},
    "duty_rule": {"threshold": {"mode": "absolute", "grid": [0.3, 0.4, 0.5, 0.6, 0.7]}},
    "robust_z": {"threshold": {"mode": "quantile", "grid": [0.99, 0.995, 0.999]}},
    "isolation_forest": {
      "variants": [
        {"n_estimators": 300, "max_samples": "auto"},
        {"n_estimators": 300, "max_samples": 2048}
      ],
      "threshold": {"mode": "quantile", "grid": [0.99, 0.995, 0.999]}
    },
    "pca_spe": {
      "variants": [{"variance": 0.9}, {"variance": 0.95}, {"variance": 0.99}],
      "threshold": {"mode": "quantile", "grid": [0.99, 0.995, 0.999]}
    }
  },
  "selection": {
    "preference": ["lps_rule", "duty_rule", "robust_z", "pca_spe", "isolation_forest"],
    "rule_detectors": ["lps_rule", "duty_rule"],
    "ml_fault_detection_min": 0.9,
    "ml_fault_fa_max": 0.1
  },
  "faults": {"n_per_type": 12, "duration_hours": 3.0, "seed": 7, "min_gap_from_reports_hours": 24}
}
