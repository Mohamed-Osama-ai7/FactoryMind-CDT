          },
          "share_at_or_below_alpha": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Observed share of held-out reference windows at or below alpha. Values well above alpha show reference drift; exceedance is not a failure probability.",
            "title": "Share At Or Below Alpha"
          },
          "windows": {
            "title": "Windows",
            "type": "integer"
          }
        },
        "required": [
          "alpha",
