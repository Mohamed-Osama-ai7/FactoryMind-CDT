          "windows"
        ],
        "title": "ReferenceHoldoutCheck",
        "type": "object"
      },
      "ReplayResponse": {
        "properties": {
          "end": {
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "episodes": {
            "items": {
              "$ref": "#/components/schemas/AlarmEpisode"
            },
            "title": "Episodes",
            "type": "array"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "operator_reports": {
            "items": {
              "$ref": "#/components/schemas/OperatorReport"
            },
            "title": "Operator Reports",
            "type": "array"
          },
          "persistence": {
            "title": "Persistence",
            "type": "integer"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "threshold": {
            "title": "Threshold",
            "type": "number"
          },
          "windows": {
            "items": {
              "$ref": "#/components/schemas/WindowResult"
            },
            "title": "Windows",
            "type": "array"
          }
        },
        "required": [
          "model_version",
          "threshold",
          "persistence",
          "start",
          "end",
          "windows",
          "episodes",
          "operator_reports"
        ],
        "title": "ReplayResponse",
        "type": "object"
      },
      "Sample": {
        "additionalProperties": false,
        "description": "One APU telemetry sample (MetroPT-3 schema).",
        "properties": {
          "COMP": {
            "enum": [
              0,
              1
            ],
            "title": "Comp",
            "type": "integer"
          },
          "Caudal_impulses": {
            "enum": [
              0,
              1
            ],
            "title": "Caudal Impulses",
            "type": "integer"
          },
          "DV_eletric": {
            "enum": [
              0,
              1
            ],
            "title": "Dv Eletric",
            "type": "integer"
          },
          "DV_pressure": {
            "title": "Dv Pressure",
            "type": "number"
          },
          "H1": {
            "title": "H1",
            "type": "number"
          },
          "LPS": {
            "enum": [
              0,
              1
            ],
            "title": "Lps",
            "type": "integer"
          },
          "MPG": {
            "enum": [
              0,
              1
            ],
            "title": "Mpg",
            "type": "integer"
          },
          "Motor_current": {
            "title": "Motor Current",
            "type": "number"
          },
          "Oil_level": {
            "enum": [
              0,
              1
            ],
            "title": "Oil Level",
            "type": "integer"
          },
          "Oil_temperature": {
            "title": "Oil Temperature",
            "type": "number"
          },
          "Pressure_switch": {
            "enum": [
              0,
              1
            ],
            "title": "Pressure Switch",
            "type": "integer"
          },
          "Reservoirs": {
            "title": "Reservoirs",
            "type": "number"
          },
          "TP2": {
            "title": "Tp2",
            "type": "number"
          },
          "TP3": {
            "title": "Tp3",
            "type": "number"
          },
          "Towers": {
            "enum": [
              0,
              1
            ],
            "title": "Towers",
            "type": "integer"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "timestamp",
          "TP2",
          "TP3",
          "H1",
          "DV_pressure",
          "Reservoirs",
          "Oil_temperature",
          "Motor_current",
          "COMP",
          "DV_eletric",
          "Towers",
          "MPG",
          "LPS",
          "Pressure_switch",
          "Oil_level",
          "Caudal_impulses"
        ],
        "title": "Sample",
        "type": "object"
      },
      "ScoreRequest": {
        "additionalProperties": false,
        "properties": {
          "samples": {
            "description": "Chronological samples forming one 10-minute window at ~0.1 Hz (>= 48 samples required to score; total span 7-11 min with 60 s tolerance, median sampling period 5-15 s, internal gaps <= 60 s, no silent resampling).",
            "items": {
              "$ref": "#/components/schemas/Sample"
            },
            "maxItems": 2000,
            "minItems": 1,
            "title": "Samples",
            "type": "array"
          }
        },
        "required": [
          "samples"
        ],
        "title": "ScoreRequest",
        "type": "object"
      },
      "ScoreResponse": {
        "properties": {
          "advisory": {
            "default": "Advisory output for human review. FactoryMind never controls equipment.",
            "title": "Advisory",
            "type": "string"
          },
          "exceedance_at_threshold": {
            "title": "Exceedance At Threshold",
            "type": "number"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/WindowResult"
          },
          "threshold": {
            "title": "Threshold",
            "type": "number"
          }
        },
        "required": [
          "model_version",
          "threshold",
          "exceedance_at_threshold",
          "result"
        ],
        "title": "ScoreResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WindowResult": {
        "properties": {
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "exceedance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Share of reference-normal windows scoring at least this high (smoothed). Not a failure probability.",
            "title": "Exceedance"
          },
          "n_samples": {
            "title": "N Samples",
            "type": "integer"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "status": {
            "description": "`stopped` is an explained state (machine off), not an anomaly.",
            "enum": [
              "normal",
              "anomalous",
              "stopped",
              "insufficient_data"
            ],
            "title": "Status",
            "type": "string"
          },
          "window_end": {
            "format": "date-time",
            "title": "Window End",
            "type": "string"
          },
          "window_start": {
            "format": "date-time",
            "title": "Window Start",
            "type": "string"
          }
        },
        "required": [
          "window_start",
          "window_end",
          "n_samples",
          "status",
          "score",
          "exceedance",
          "evidence"
        ],
        "title": "WindowResult",
        "type": "object"
      }
    }
