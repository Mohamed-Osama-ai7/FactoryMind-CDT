        },
        "required": [
          "model_version",
          "detector",
          "selected_as_default",
          "selection_rationale",
          "dataset_id",
          "dataset_license",
          "dataset_source",
          "data_kind",
          "training_period",
          "threshold",
          "persistence",
          "exceedance_at_threshold",
          "window_length",
          "loeo",
          "fault_injection",
          "intended_use",
          "limitations",
          "replay_available_from",
          "replay_available_to",
          "operator_reports"
