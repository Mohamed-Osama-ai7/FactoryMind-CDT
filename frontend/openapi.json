          "failure"
        ],
        "title": "OperatorReport",
        "type": "object"
      },
      "ReferenceHoldoutCheck": {
        "properties": {
          "alpha": {
            "description": "Nominal exceedance alpha tested on split-half holdout.",
            "title": "Alpha",
