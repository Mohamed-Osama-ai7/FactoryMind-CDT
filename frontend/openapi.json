  "info": {
    "description": "Evidence-grounded, uncertainty-aware decision support. Advisory only.",
    "title": "FactoryMind CDT API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/anomaly/model": {
      "get": {
        "operationId": "anomaly_model",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Anomaly Model",
        "tags": [
          "anomaly"
        ]
      }
    },
    "/api/v1/anomaly/replay": {
      "get": {
        "operationId": "anomaly_replay",
        "parameters": [
          {
            "description": "Range start (naive local train time)",
            "in": "query",
            "name": "start",
            "required": true,
            "schema": {
              "description": "Range start (naive local train time)",
              "format": "date-time",
              "title": "Start",
              "type": "string"
            }
          },
          {
            "description": "Range end, exclusive; at most 7 days after start",
            "in": "query",
            "name": "end",
            "required": true,
            "schema": {
              "description": "Range end, exclusive; at most 7 days after start",
              "format": "date-time",
              "title": "End",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplayResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Anomaly Replay",
        "tags": [
          "anomaly"
        ]
      }
    },
    "/api/v1/anomaly/score": {
      "post": {
        "operationId": "anomaly_score",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Anomaly Score",
        "tags": [
          "anomaly"
        ]
      }
    },
    "/api/v1/audit/events": {
      "get": {
        "operationId": "audit_events",
        "parameters": [
          {
            "in": "query",
            "name": "action",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "pattern": "^[a-z_.]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Action"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 10000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Audit Events",
        "tags": [
          "incidents"
        ]
      }
    },
    "/api/v1/audit/verify": {
      "get": {
        "operationId": "audit_verify",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditVerification"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Audit Verify",
        "tags": [
          "incidents"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
